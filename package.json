{
  "name": "thief-write",
  "displayName": "Thief Write - 隐写盲打",
  "description": "一个用于在公共场合盲打私人内容的 VS Code 扩展，输入的真实内容不会显示在编辑器里。",
  "version": "0.0.3",
  "publisher": "ZnPdCo",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/znpdco/thief-write"
  },
  "keywords": [
    "隐写",
    "盲打",
    "隐私",
    "stealth",
    "writing"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "thief.toggle",
        "title": "Thief Write: 在隐写视图与真实文件明文之间切换"
      },
      {
        "command": "thief.toggleName",
        "title": "Thief Write: 切换隐写标签显示名"
      },
      {
        "command": "thief.toggleRecent",
        "title": "Thief Write: 切换右下角真实字符提示"
      }
    ],
    "keybindings": [
      {
        "command": "thief.toggle",
        "key": "ctrl+alt+t"
      },
      {
        "command": "thief.toggleName",
        "key": "ctrl+alt+n"
      },
      {
        "command": "thief.toggleRecent",
        "key": "ctrl+alt+r"
      }
    ],
    "languages": [
      {
        "id": "stealth-text",
        "aliases": [
          "Stealth Text"
        ]
      }
    ],
    "grammars": [
      {
        "language": "stealth-text",
        "scopeName": "source.stealth-text",
        "path": "./syntaxes/stealth-text.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[stealth-text]": {
        "editor.minimap.enabled": false,
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": false
        },
        "editor.suggestOnTriggerCharacters": false,
        "editor.wordBasedSuggestions": "off",
        "editor.hover.enabled": "off",
        "editor.selectionHighlight": false,
        "editor.occurrencesHighlight": "off",
        "editor.matchBrackets": "never",
        "editor.renderLineHighlight": "none",
        "editor.colorDecorators": false
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "meta.thiefwrite.hidden",
            "settings": {
              "foreground": "#00000000"
            }
          }
        ]
      }
    },
    "configuration": {
      "title": "Thief Write",
      "properties": {
        "thiefWrite.recentIndicator": {
          "type": "boolean",
          "default": true,
          "description": "在隐写模式下，于状态栏右侧显示当前真实光标两侧的字符 [左|右]，换行显示为 ⏎。"
        },
        "thiefWrite.displayName": {
          "type": "string",
          "default": "Untitled-1",
          "description": "隐写视图标签页显示的伪装文件名。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
